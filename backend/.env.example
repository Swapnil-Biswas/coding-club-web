# Server
PORT=3001

# Set to a long random string in production. Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Used to sign cookies. Must be the same across restarts so users don't get logged out
# on every deploy in dev. In production, set a stable value.
# COOKIE_SIGN_KEY (optional) — falls back to SESSION_SECRET if unset.
COOKIE_SIGN_KEY=dev-cookie-sign-key

# SQLite file path (relative to backend/). Created if missing.
DATABASE_FILE=./data/app.db

# Email domain enforced on signup. Case-insensitive match on the suffix.
# CHANGE THIS to your college domain before going live.
ALLOWED_EMAIL_DOMAIN=@bmsit.in

# Bootstrap admin (used by `npm run seed:admin`). Set to The Chosen Admin's
# @bmsit.in address, then run `npm run seed:admin`.
SEED_ADMIN_EMAIL=placeholder@bmsit.in
SEED_ADMIN_PASSWORD=change-this-to-a-strong-password
SEED_ADMIN_NAME=Admin

# CORS origin for the dev servers (Next.js on 3000, legacy Vite on 5173).
# Comma-separated for multiple.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
