# Server
PORT=3001

# Set to a long random string in production. Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# HMAC key for verification-code storage. Use a separate random value in production.
VERIFICATION_CODE_SECRET=change-me-to-a-separate-long-random-string

# Development only. Never enable in production.
LOG_VERIFICATION_CODES=false

# SQLite file path (relative to backend/). Created if missing.
DATABASE_FILE=./data/app.db

# Email domain enforced on signup. Case-insensitive match on the suffix.
# CHANGE THIS to your college domain before going live.
ALLOWED_EMAIL_DOMAIN=@bmsit.in

# Bootstrap admin (used by `npm run seed:admin`). Set to The Chosen Admin's
# @bmsit.in address, then run `npm run seed:admin`.
SEED_ADMIN_EMAIL=placeholder@bmsit.in
SEED_ADMIN_PASSWORD=change-this-to-a-strong-password
SEED_ADMIN_NAME=Admin

# Public browser origin used for same-origin CSRF validation.
# Production must use the exact HTTPS origin serving the frontend.
APP_ORIGIN=http://localhost:3000

# Additional exact browser origins allowed to call the API, comma-separated.
CORS_ORIGIN=http://localhost:5173

# Production CIDRs or exact IPs of reverse proxies allowed to supply client IPs.
# Leave empty locally. The backend port must also be private to these proxies.
TRUST_PROXY_CIDRS=

# Resend — email delivery for verification codes.
# 1. Create a free account at https://resend.com
# 2. Add & verify your sending domain (or use the sandbox for testing).
# 3. Create an API key and paste it below.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Coding Club <noreply@yourdomain.com>
